# Server only. Never use a VITE_ prefix for secrets.
DEEPSEEK_API_KEY=replace-with-your-key
APP_ENV=development
# Production requires an authenticated reverse proxy that injects this server secret.
# GATEWAY_TOKEN=replace-with-at-least-32-random-characters
# ALLOWED_HOSTS=["echochat.example.com"]
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
CONNECT_TIMEOUT_SECONDS=10
READ_TIMEOUT_SECONDS=60
STREAM_TIMEOUT_SECONDS=300
HEARTBEAT_SECONDS=15
MAX_CONCURRENT_STREAMS=8
MAX_REQUEST_BYTES=262144
MAX_OUTPUT_TOKENS=4096
